# Copy to .env and edit. NEVER commit .env. All values are read by the backend only.

# development | production. Production refuses to serve private routes without a token.
OMNI_ENV=development

# Your single-owner login. Generate a long random value, e.g.:
#   PowerShell:  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})
#   Linux/macOS: openssl rand -base64 32
OMNI_ACCESS_TOKEN=

# Where SQLite lives. On hosts with an ephemeral disk this data is LOST on restart.
# OMNI_DB_PATH=./data/omni.db

# Comma-separated browser origins allowed to call the API (only needed if the
# frontend is hosted on a different origin than the backend).
OMNI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI provider (used from Phase 2) ---
# groq (primary candidate) | ollama | openrouter | huggingface
OMNI_AI_PROVIDER=groq
# Pick after listing the provider's current models (Phase 2 does this for you).
OMNI_AI_MODEL=
# Leave empty to use the adapter's default endpoint.
OMNI_AI_BASE_URL=
# Free-tier key from the provider's console. Server-side only.
OMNI_AI_API_KEY=
# Hard guard: OMNI never routes to a paid provider unless you flip this yourself.
OMNI_ALLOW_PAID_PROVIDERS=false

# --- Model output / context limits ---
# OMNI_AI_MAX_OUTPUT_TOKENS=1024
# OMNI_CONTEXT_CHAR_BUDGET=12000

# --- Web search (optional; empty = disabled) ---
# tavily: free plan = 1,000 credits/month, no card (checked 2026-10-20). searxng: self-hosted.
OMNI_SEARCH_PROVIDER=
OMNI_SEARCH_API_KEY=
# OMNI_SEARCH_BASE_URL=https://your-searxng.example
# OMNI_SEARCH_DAILY_CAP=30

# --- Authorized documents folder (optional; empty = document tools disabled). Read-only. ---
# OMNI_DOCS_DIR=/data/docs
