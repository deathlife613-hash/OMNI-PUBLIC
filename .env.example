# Copy to .env and edit. NEVER commit .env. All values are read by the backend only.

# development | production. Production refuses to serve private routes without a token.
OMNI_ENV=development

# Your single-owner login. Generate a long random value, e.g.:
#   PowerShell:  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})
#   Linux/macOS: openssl rand -base64 32
OMNI_ACCESS_TOKEN=

# Production with an EMPTY token refuses to serve (fail closed). Set true ONLY if you accept that anyone
# with the URL can use your model quota and read/replace your data. A token, when set, is always enforced.
# OMNI_ALLOW_OPEN_ACCESS=false

# --- Persistence for hosts with an ephemeral disk (Render free etc.): snapshots to a PRIVATE HF Dataset ---
# OMNI_SYNC_PROVIDER=hf_dataset
# OMNI_SYNC_HF_REPO=yourname/omni-data
# OMNI_SYNC_HF_TOKEN=            # fine-grained token, write access to that one dataset only
# OMNI_SYNC_INTERVAL_S=120

# --- Postgres (e.g. a free Neon project) instead of SQLite. Empty = SQLite. WRITTEN, NOT YET VERIFIED. ---
# Use Neon's connection string (it includes sslmode=require). Server-side secret: it contains the password.
# Migrating existing data: Memory tab -> export, set this, restart, Memory tab -> restore.
# OMNI_DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# OMNI_DATABASE_SCHEMA=            # optional; leave empty for the default schema

# Where SQLite lives. On hosts with an ephemeral disk this data is LOST on restart.
# OMNI_DB_PATH=./data/omni.db

# Comma-separated browser origins allowed to call the API (only needed if the
# frontend is hosted on a different origin than the backend).
OMNI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI provider (used from Phase 2) ---
# groq | ollama (Ollama Cloud free plan; or local: set OMNI_AI_BASE_URL=http://localhost:11434/v1, no key)
# | openrouter (":free" models only) | huggingface (free accounts have NO included credits - see docs)
OMNI_AI_PROVIDER=groq
# Pick after listing the provider's current models (Phase 2 does this for you).
# Leave unset to use the recommended default (Groq: openai/gpt-oss-120b); set to "" for none.
# OMNI_AI_MODEL=openai/gpt-oss-120b
# Leave empty to use the adapter's default endpoint.
OMNI_AI_BASE_URL=
# Free-tier key from the provider's console. Server-side only.
OMNI_AI_API_KEY=
# Hard guard: OMNI never routes to a paid provider unless you flip this yourself.
OMNI_ALLOW_PAID_PROVIDERS=false

# --- Model output / context limits ---
# OMNI_AI_MAX_OUTPUT_TOKENS=1024
# OMNI_CONTEXT_CHAR_BUDGET=12000

# --- Web search. auto = DuckDuckGo (scraped, unofficial) then Wikipedia; no signup. Empty = disabled. ---
# Also: duckduckgo | wikipedia | tavily (free plan 1,000 credits/month, no card, checked 2026-10-20) | searxng
OMNI_SEARCH_PROVIDER=auto
OMNI_SEARCH_API_KEY=
# OMNI_SEARCH_BASE_URL=https://your-searxng.example
# OMNI_SEARCH_DAILY_CAP=30

# --- Authorized documents folder (optional; empty = document tools disabled). Read-only. ---
# OMNI_DOCS_DIR=/data/docs

# --- Optional server-side voice (ElevenLabs). Leave empty to use the browser's own voices. ---
# Free plan ~10k credits/month (about 10 min of speech); API access on the free plan is UNVERIFIED until a real key works.
# OMNI_TTS_PROVIDER=elevenlabs
# OMNI_TTS_API_KEY=               # server env only; never commit or paste in chat
# OMNI_TTS_VOICE_ID=              # required; copy a voice id from your ElevenLabs voice list
# OMNI_TTS_MODEL=eleven_flash_v2_5   # unverified default; check GET /v1/models
# OMNI_TTS_MAX_CHARS_PER_REPLY=1500
# OMNI_TTS_MONTHLY_CHAR_CAP=8000     # OMNI's own estimate guard (resets on restart)
